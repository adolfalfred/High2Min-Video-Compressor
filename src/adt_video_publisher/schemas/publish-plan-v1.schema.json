{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tie.go.tz/schemas/high2min/publish-plan-v1.schema.json",
  "title": "High2Min ADT publish preview",
  "type": "object",
  "required": ["schema_version", "ready", "book", "video_root", "language", "mode", "page_count", "page_hrefs", "videos", "active_runtime_files", "mutations", "removals", "warnings", "blockers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "command": {"const": "publish-plan"},
    "ok": {"type": "boolean"},
    "exit_code": {"type": "integer"},
    "ready": {"type": "boolean"},
    "book": {"type": "string", "minLength": 1},
    "video_root": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "mode": {"enum": ["merge", "replace"]},
    "page_count": {"type": "integer", "minimum": 1},
    "page_hrefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "source_filename", "page_index", "page_href", "mapping_key", "destination_filename", "size_bytes"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "source_filename": {"type": "string", "minLength": 1},
          "page_index": {"type": "integer", "minimum": 1},
          "page_href": {"type": "string", "minLength": 1},
          "mapping_key": {"type": "string", "pattern": "^video-[1-9][0-9]*$"},
          "destination_filename": {"type": "string", "pattern": "^page_[1-9][0-9]*\\.mp4$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "existing_mappings": {"type": "object", "additionalProperties": {"type": "string"}},
    "active_runtime_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "helper_files": {"type": "object"},
    "offline_preloader_format": {"type": "string"},
    "manifest_file_count": {"type": "integer", "minimum": 1},
    "git": {"type": "object"},
    "mutations": {"type": "array", "items": {"type": "string"}},
    "removals": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "zip_sentinels": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "additionalProperties": false
}
